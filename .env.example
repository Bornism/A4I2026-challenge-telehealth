# Optional overrides for scripts/load.sh and notebooks/
# Copy to .env (git-ignored) only if using a custom Cloud Storage snapshot bucket or dataset.

# Cloud Storage bucket hosting pre-staged snapshots (leave unset to load from repo data/*.parquet)
A4I_SNAPSHOT_BUCKET=
A4I_SNAPSHOT_PREFIX=a4i-2026/challenge-telehealth

# Target BigQuery dataset and location in your team's GCP project
A4I_DATASET=a4i_telehealth
A4I_LOCATION=US

# Per-command timeout in seconds for gcloud / bq CLI calls
A4I_CMD_TIMEOUT_SEC=180
